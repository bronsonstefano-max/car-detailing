{
  "name": "divine-detailers",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/styles.min.css", "!/script.min.js"]
  },
  // Lead database. Wrangler creates it automatically on the first deploy if it does not exist yet.
  "d1_databases": [{ "binding": "DB", "database_name": "divine-detailers-leads" }],
  // After divinedetailers.com is added to Cloudflare, uncomment this to serve the site on the domain and the lead dashboard at crm.divinedetailers.com,
  // and set "CRM_HOST" below. (Deploying these before the domain is on your Cloudflare account makes the build fail.)
  // "routes": [
  //   { "pattern": "divinedetailers.com", "custom_domain": true },
  //   { "pattern": "www.divinedetailers.com", "custom_domain": true },
  //   { "pattern": "crm.divinedetailers.com", "custom_domain": true }
  // ],
  "vars": {
    "CRM_HOST": "",
    // Who gets an email for every new lead (needs the RESEND_API_KEY secret). Comma separated.
    "NOTIFY_TO": "",
    "NOTIFY_FROM": "",
    "ALERT_SMS_TO": "",
    "AUTO_REPLY": "",
    "GOOGLE_REVIEW_URL": ""
  }
}
